<?xml version="1.0" encoding="utf-8"?>
<!--
    No internet permission on purpose. Videos and other files still come through the system picker or another
    app's share. The first three below are only for sound that keeps playing after leaving: audio files, and video
    if chosen. The last two read songs only, are asked for when the user taps to find their music, and are optional.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:name=".ui.BabarifyApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/no_backup"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Babarify">
        <activity
            android:name=".ui.HomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Handles rotation itself, so turning the phone does not interrupt playback. -->
        <activity
            android:name=".ui.PlayerActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTop"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.Babarify.Player">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.AboutActivity"
            android:exported="false" />
        <activity
            android:name=".ui.MusicActivity"
            android:exported="false" />
        <activity
            android:name=".ui.MusicGroupActivity"
            android:exported="false" />
        <activity
            android:name=".ui.LibraryActivity"
            android:exported="false" />
        <activity
            android:name=".ui.PlaylistsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.PlaylistActivity"
            android:exported="false" />
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false" />
        <!-- Not exported: only the small window's own button can reach it. -->
        <receiver
            android:name=".ui.PictureToggleReceiver"
            android:exported="false" />
        <service
            android:name=".engine.BackgroundPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>
