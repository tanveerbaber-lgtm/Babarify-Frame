<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Colours from the desktop theme (ui/theme.py). -->
    <color name="background">#070B15</color>
    <color name="surface">#0E1628</color>
    <color name="surface_raised">#16213A</color>
    <color name="border">#22304D</color>
    <color name="text">#E6EDF7</color>
    <color name="text_muted">#A3B1C9</color>
    <color name="accent">#3B82F6</color>
    <color name="cyan">#22D3EE</color>
    <color name="on_accent">#04101F</color>
    <color name="warning">#F59E0B</color>

    <style name="Theme.Babarify" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorPrimary">@color/surface</item>
        <item name="android:colorAccent">@color/cyan</item>
        <item name="android:colorControlActivated">@color/cyan</item>
        <item name="android:colorButtonNormal">@color/surface_raised</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_muted</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:buttonStyle">@style/SoftButton</item>
        <item name="android:seekBarStyle">@style/Slider</item>
        <item name="android:alertDialogTheme">@style/Theme.Babarify.Dialog</item>
    </style>

    <!-- The video reaches every edge of the screen, around the camera too. -->
    <style name="Theme.Babarify.Player">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <style name="Theme.Babarify.Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:colorAccent">@color/cyan</item>
        <item name="android:colorControlActivated">@color/cyan</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_muted</item>
        <item name="android:buttonStyle">@style/SoftButton</item>
        <item name="android:seekBarStyle">@style/Slider</item>
        <item name="android:buttonBarButtonStyle">@style/DialogAction</item>
    </style>

    <style name="DialogAction" parent="android:Widget.Material.Button.Borderless.Colored">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/cyan</item>
    </style>

    <style name="SoftButton" parent="android:Widget.Material.Button">
        <item name="android:background">@drawable/bg_soft_button</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Slider" parent="android:Widget.Material.SeekBar">
        <item name="android:progressDrawable">@drawable/seek_track</item>
        <item name="android:thumb">@drawable/seek_thumb</item>
        <item name="android:splitTrack">false</item>
    </style>

    <style name="PrimaryButton" parent="SoftButton">
        <item name="android:background">@drawable/bg_primary</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:drawableTint">@color/on_accent</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:paddingHorizontal">20dp</item>
    </style>

    <style name="Text.Title" parent="">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Body" parent="">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Text.Muted" parent="">
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Text.Section" parent="">
        <item name="android:textColor">@color/cyan</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="Text.Time" parent="">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">monospace</item>
    </style>

    <style name="ControlButton" parent="android:Widget.Material.Button.Borderless">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/cyan</item>
    </style>

    <style name="NavBar" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:background">@color/surface</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="NavTab" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_row</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="NavIcon" parent="">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="NavLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="MediaList" parent="">
        <item name="android:divider">@null</item>
        <item name="android:dividerHeight">0dp</item>
        <item name="android:listSelector">@drawable/bg_row</item>
        <item name="android:drawSelectorOnTop">true</item>
    </style>

    <style name="IconButton" parent="">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/bg_round</item>
        <item name="android:scaleType">center</item>
        <item name="android:tint">@color/text</item>
    </style>

    <style name="TransportSeek" parent="">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_marginHorizontal">8dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:backgroundTint">@color/text</item>
    </style>

    <style name="ToolText" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_row</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:drawableTint">@color/text</item>
    </style>

    <style name="ToolIcon" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_row</item>
        <item name="android:scaleType">center</item>
        <item name="android:tint">@color/text</item>
    </style>
</resources>
