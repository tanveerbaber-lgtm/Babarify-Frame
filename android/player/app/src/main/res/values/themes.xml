<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Colours from the desktop theme (ui/theme.py). -->
    <color name="background">#070B15</color>
    <color name="surface">#0E1628</color>
    <color name="surface_raised">#16213A</color>
    <color name="border">#22304D</color>
    <color name="text">#E6EDF7</color>
    <color name="text_muted">#A3B1C9</color>
    <color name="accent">#3B82F6</color>
    <color name="cyan">#22D3EE</color>
    <color name="on_accent">#04101F</color>
    <color name="warning">#F59E0B</color>

    <style name="Theme.Babarify" parent="android:Theme.Material.NoActionBar">
        <item name="bgColor">@color/background</item>
        <item name="surfaceColor">@color/surface</item>
        <item name="raisedColor">@color/surface_raised</item>
        <item name="borderColor">@color/border</item>
        <item name="accentColor">@color/accent</item>
        <item name="accent2Color">@color/cyan</item>
        <item name="inkColor">@color/text</item>
        <item name="inkMutedColor">@color/text_muted</item>
        <item name="onAccentColor">@color/on_accent</item>
        <item name="rippleTint">#33FFFFFF</item>
        <item name="trackColor">#66FFFFFF</item>
        <item name="android:colorControlNormal">?attr/inkMutedColor</item>
        <item name="android:colorBackground">?attr/bgColor</item>
        <item name="android:windowBackground">?attr/bgColor</item>
        <item name="android:colorPrimary">?attr/surfaceColor</item>
        <item name="android:colorAccent">?attr/accent2Color</item>
        <item name="android:colorControlActivated">?attr/accent2Color</item>
        <item name="android:colorButtonNormal">?attr/raisedColor</item>
        <item name="android:textColorPrimary">?attr/inkColor</item>
        <item name="android:textColorSecondary">?attr/inkMutedColor</item>
        <item name="android:textColorPrimaryDisableOnly">?attr/inkColor</item>
        <item name="android:statusBarColor">?attr/bgColor</item>
        <item name="android:navigationBarColor">?attr/surfaceColor</item>
        <item name="android:fontFamily">@font/arimo_family</item>
        <item name="android:buttonStyle">@style/SoftButton</item>
        <item name="android:seekBarStyle">@style/Slider</item>
        <item name="android:alertDialogTheme">@style/Theme.Babarify.Dialog</item>
        <!-- Android 12 and later: a plain start-up screen in the intro's colour, so the intro isn't shown twice. -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/background</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/splash_blank</item>
        <item name="android:windowSplashScreenIconBackgroundColor" tools:targetApi="31">@color/background</item>
    </style>

    <!-- The video reaches every edge of the screen, around the camera too. -->
    <style name="Theme.Babarify.Player">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <!-- For Home, the library, playlists and Settings. The player stays dark: its controls sit on video. -->
    <style name="Colours.Light" parent="">
        <item name="bgColor">#F5F7FB</item>
        <item name="surfaceColor">#FFFFFF</item>
        <item name="raisedColor">#EAEEF5</item>
        <item name="borderColor">#D5DCE8</item>
        <item name="accentColor">#1D4ED8</item>
        <item name="accent2Color">#0E7490</item>
        <item name="inkColor">#111827</item>
        <item name="inkMutedColor">#55627A</item>
        <item name="onAccentColor">#FFFFFF</item>
        <item name="rippleTint">#22000000</item>
        <item name="trackColor">#55111827</item>
        <item name="android:textColorHint">#55627A</item>
        <item name="android:colorForeground">#111827</item>
        <item name="android:colorBackgroundFloating">#FFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- Colour themes, laid over the theme above. These are dark, so the text colours stay readable. -->
    <style name="Colours.Sunset" parent="">
        <item name="bgColor">#160A12</item>
        <item name="surfaceColor">#241320</item>
        <item name="raisedColor">#351C2E</item>
        <item name="borderColor">#4A2A40</item>
        <item name="accentColor">#F97316</item>
        <item name="accent2Color">#FB7185</item>
    </style>

    <style name="Colours.Forest" parent="">
        <item name="bgColor">#06130F</item>
        <item name="surfaceColor">#0D211B</item>
        <item name="raisedColor">#153228</item>
        <item name="borderColor">#214A3B</item>
        <item name="accentColor">#10B981</item>
        <item name="accent2Color">#5EEAD4</item>
    </style>

    <style name="Colours.Violet" parent="">
        <item name="bgColor">#0E0A1C</item>
        <item name="surfaceColor">#191233</item>
        <item name="raisedColor">#251B49</item>
        <item name="borderColor">#3A2C69</item>
        <item name="accentColor">#8B5CF6</item>
        <item name="accent2Color">#E879F9</item>
    </style>

    <style name="Colours.Amber" parent="">
        <item name="bgColor">#11100B</item>
        <item name="surfaceColor">#1E1B12</item>
        <item name="raisedColor">#2C281A</item>
        <item name="borderColor">#443D27</item>
        <item name="accentColor">#F59E0B</item>
        <item name="accent2Color">#FDE047</item>
    </style>

    <style name="Colours.Rose" parent="">
        <item name="bgColor">#170A10</item>
        <item name="surfaceColor">#27111B</item>
        <item name="raisedColor">#3A1828</item>
        <item name="borderColor">#55253C</item>
        <item name="accentColor">#E11D48</item>
        <item name="accent2Color">#F9A8D4</item>
    </style>

    <style name="Theme.Babarify.Panel">
        <item name="android:windowBackground">?attr/bgColor</item>
    </style>

    <style name="PillButton" parent="SoftButton">
        <item name="android:layout_height">44dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:drawableTint">?attr/accent2Color</item>
    </style>

    <style name="MusicTab" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/bg_tab</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Theme.Babarify.Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:colorAccent">?attr/accent2Color</item>
        <item name="android:colorControlActivated">?attr/accent2Color</item>
        <item name="android:textColorPrimary">?attr/inkColor</item>
        <item name="android:textColorSecondary">?attr/inkMutedColor</item>
        <item name="android:textColorAlertDialogListItem">?attr/inkColor</item>
        <item name="android:fontFamily">@font/arimo_family</item>
        <item name="android:textColorPrimaryDisableOnly">?attr/inkColor</item>
        <item name="android:buttonStyle">@style/SoftButton</item>
        <item name="android:seekBarStyle">@style/Slider</item>
        <item name="android:buttonBarButtonStyle">@style/DialogAction</item>
    </style>

    <style name="DialogAction" parent="android:Widget.Material.Button.Borderless.Colored">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">?attr/accent2Color</item>
    </style>

    <style name="SoftButton" parent="android:Widget.Material.Button">
        <item name="android:background">@drawable/bg_soft_button</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">?attr/inkColor</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Slider" parent="android:Widget.Material.SeekBar">
        <item name="android:progressDrawable">@drawable/seek_track</item>
        <item name="android:thumb">@drawable/seek_thumb</item>
        <item name="android:splitTrack">false</item>
    </style>

    <style name="PrimaryButton" parent="SoftButton">
        <item name="android:background">@drawable/bg_primary</item>
        <item name="android:textColor">?attr/onAccentColor</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:drawableTint">?attr/onAccentColor</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:paddingHorizontal">20dp</item>
    </style>

    <style name="Text.Title" parent="">
        <item name="android:textColor">?attr/inkColor</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Body" parent="">
        <item name="android:textColor">?attr/inkColor</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Text.Muted" parent="">
        <item name="android:textColor">?attr/inkMutedColor</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Text.Section" parent="">
        <item name="android:textColor">?attr/accent2Color</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="Text.Time" parent="">
        <item name="android:textColor">?attr/inkColor</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">monospace</item>
    </style>

    <style name="ControlButton" parent="android:Widget.Material.Button.Borderless">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">?attr/accent2Color</item>
    </style>

    <style name="NavBar" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:background">?attr/surfaceColor</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="NavTab" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_row</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="NavIcon" parent="">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="NavLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="MediaList" parent="">
        <item name="android:divider">@null</item>
        <item name="android:dividerHeight">0dp</item>
        <item name="android:listSelector">@drawable/bg_row</item>
        <item name="android:drawSelectorOnTop">true</item>
    </style>

    <style name="IconButton" parent="">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/bg_round</item>
        <item name="android:scaleType">center</item>
        <item name="android:tint">?attr/inkColor</item>
    </style>

    <style name="TransportSeek" parent="">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_marginHorizontal">8dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">?attr/inkColor</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:backgroundTint">?attr/inkColor</item>
    </style>

    <style name="ToolText" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_row</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">?attr/inkColor</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:drawableTint">?attr/inkColor</item>
    </style>

    <style name="ToolIcon" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_row</item>
        <item name="android:scaleType">center</item>
        <item name="android:tint">?attr/inkColor</item>
    </style>
</resources>
