<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/playlistsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/playlistsTitle"
        style="@style/Text.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:paddingHorizontal="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp"
        android:singleLine="true"
        android:text="@string/playlists" />

    <Button
        android:id="@+id/playlistsAction"
        style="@style/PrimaryButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:id="@+id/playlistTools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/playlistsAdd"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:drawableStart="@drawable/ic_add"
            android:drawableTint="@color/text"
            android:paddingHorizontal="16dp"
            android:text="@string/add_media" />

        <Button
            android:id="@+id/playlistsShuffle"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:drawableStart="@drawable/ic_shuffle"
            android:drawableTint="@color/text"
            android:paddingHorizontal="16dp"
            android:text="@string/shuffle" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/playlistsList"
            style="@style/MediaList"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/playlistsEmpty"
            style="@style/Text.Muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:drawableTop="@drawable/ic_playlist"
            android:drawablePadding="12dp"
            android:drawableTint="@color/text_muted"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone" />
    </FrameLayout>

    <include layout="@layout/now_playing" />

    <LinearLayout
        android:id="@+id/bottomNav"
        style="@style/NavBar" />
</LinearLayout>
