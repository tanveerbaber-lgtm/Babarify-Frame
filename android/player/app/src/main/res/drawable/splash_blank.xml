<!-- Android 12 and later show an icon while an app starts. Ours stays empty: the app's own intro shows the icon. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <size
        android:width="1dp"
        android:height="1dp" />
</shape>
